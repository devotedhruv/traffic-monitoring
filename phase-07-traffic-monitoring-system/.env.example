TRAFFIC_VIDEO_SOURCE=videos/traffic.mp4
# Optional common production override for both uploaded-video and live detection.
# Keep weights inside this repository and use a relative path.
TRAFFIC_VEHICLE_MODEL_PATH=
TRAFFIC_MODEL_PATH=models/yolo11s.pt
TRAFFIC_LIVE_MODEL_PATH=models/yolov8n.pt
TRAFFIC_LIVE_IMAGE_SIZE=640
TRAFFIC_VEHICLE_CONFIDENCE=0.10
TRAFFIC_LIVE_CONFIDENCE=0.10
TRAFFIC_LIVE_STREAM_FPS=15
TRAFFIC_LIVE_STREAM_WIDTH=960
TRAFFIC_LIVE_TRACKER=config/live_bytetrack.yaml
TRAFFIC_LIVE_PREPROCESS_FILES=true
TRAFFIC_LIVE_ACCURATE_FILE_MODE=true
TRAFFIC_LIVE_FILE_ANALYSIS_FPS=2
# Bundled traffic.mp4 profile: far-left;far-right;near-right;near-left (normalized x,y).
TRAFFIC_LIVE_ROAD_PROFILE=auto
TRAFFIC_LIVE_ROAD_POINTS=0.27,0.50;0.69,0.50;0.88,0.98;0.06,0.98
TRAFFIC_LIVE_ROAD_WIDTH_METERS=13
TRAFFIC_LIVE_ROAD_LENGTH_METERS=50
TRAFFIC_LIVE_ROAD_CALIBRATION_QUALITY=0.60
TRAFFIC_LIVE_MIN_SPEED_SAMPLES=2
TRAFFIC_LIVE_MIN_SPEED_CONFIDENCE=0.45
TRAFFIC_PLATE_MODEL_PATH=
TRAFFIC_PLATE_OCR_ENGINE=tesseract
# Install both Tesseract language packs for Nepal plates; unavailable packs fall back safely.
TRAFFIC_PLATE_OCR_LANGUAGES=nep+eng
TRAFFIC_PLATE_CONFIDENCE=0.35
TRAFFIC_PLATE_MIN_QUALITY=0.18
TRAFFIC_PLATE_SAMPLE_SECONDS=0.75
TRAFFIC_HELMET_MODEL_PATH=
TRAFFIC_HELMET_CONFIDENCE=0.35
TRAFFIC_LIVE_HELMET_CONFIDENCE=0.35
TRAFFIC_LIVE_HELMET_CONFIRMATIONS=3
TRAFFIC_LIVE_HELMET_SAMPLE_SECONDS=0.75
# JSON array of measured per-camera lane boundaries/rules; blank means Not configured.
TRAFFIC_LIVE_LANE_RULES=
TRAFFIC_LIVE_ALLOWED_DIRECTION=both
TRAFFIC_LIVE_LANE_CONFIRMATIONS=5
TRAFFIC_LIVE_LANE_GRACE_SECONDS=1.0
TRAFFIC_LIVE_LANE_MIN_TRAJECTORY_SECONDS=0.75
TRAFFIC_LIVE_LANE_MIN_DISTANCE_METERS=1.0
TRAFFIC_TESSERACT_CMD=tesseract
TRAFFIC_TRACKER=botsort.yaml
TRAFFIC_ANALYSIS_FPS=15
TRAFFIC_DETECTOR_IMAGE_SIZE=960
TRAFFIC_DATABASE_PATH=database/traffic.db
TRAFFIC_SPEED_LIMIT=50
TRAFFIC_METERS_PER_PIXEL=0.05
TRAFFIC_CAMERA_ID=camera-01
TRAFFIC_CAMERA_NAME=North Junction
TRAFFIC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRAFFIC_AUTOSTART=true
TRAFFIC_AUTH_SESSION_HOURS=168
TRAFFIC_AUTH_COOKIE_SECURE=false
TRAFFIC_ALERT_COOLDOWN_SECONDS=30
